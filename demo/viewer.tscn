[node name="CodeEdit" type="CodeEdit" parent="UI/RootVBox/Workspace/EditorContainer/EditorLayout/Tabs/CodeEditorTab/CodeBox" unique_id=1955730074]
layout_mode = 0
anchor_right = 1.0
anchor_bottom = 1.0
theme_override_styles/normal = SubResource("StyleBoxFlat_eh5o7")
text = "var base_box := Bdg.make_box(3.0, 3.0, 3.0)
var main_shape: BdgShape = base_box

for f in Bdg.faces(base_box):
	var face: BdgFace = f as BdgFace
	var p := Bdg.to_plane(face)
	var rect := Bdg.make_rect(1.0, 2.0, p)
	var rot_axis := Bdg.axis(p.origin, p.z_dir)
	var rot_rect := Bdg.rotate(rect, rot_axis, 45.0) as BdgFace
	var extr_part := Bdg.extrude_vec(rot_rect, p.z_dir * 0.1)
	main_shape = Bdg.fuse(main_shape, extr_part)

return main_shape"
syntax_highlighter = SubResource("CodeHighlighter_t2dwm")
highlight_all_occurrences = true
highlight_current_line = true
gutters_draw_line_numbers = true
gutters_draw_fold_gutter = true
code_completion_enabled = true
code_completion_prefixes = Array[String](["B", "V", "C", "."])
indent_automatic = true
auto_brace_completion_enabled = true

