[node name="ApiDoc" type="RichTextLabel" parent="UI/RootVBox/Workspace/EditorContainer/EditorLayout/Tabs/ApiTab/ApiSplit/ApiDetail" unique_id=452283611]
layout_mode = 2
size_flags_vertical = 3
focus_mode = 2
bbcode_enabled = true
text = "[b][color=#6bc9ff]Bdg.build_part[/color][/b]  [color=#ffd166][Builders][/color]
[color=#8cd3ff][b]Signature:[/b][/color] [code][color=#e0e8f5]Bdg.build_part(block: Callable) -> BdgPart[/color][/code]
[color=#a0a8b4]Builds a 3D Part by executing a callback closure. 3D primitives and boolean operations inside the closure automatically combine into a final solid model.[/color]

[b][color=#8cd3ff]Parameters:[/color][/b]
  • [b][color=#ffd166]block[/color][/b] ([color=#85d7ff]Callable[/color]): [color=#cfd8dc]Closure callback that creates 3D shapes (e.g. box, cylinder, extrude).[/color]

[b][color=#8cd3ff]Example:[/color][/b]
[code][color=#a8ffb2]var part = Bdg.build_part(func():
    Bdg.box(50.0, 30.0, 10.0)
    Bdg.hole(4.0, 12.0)
)[/color][/code]"
selection_enabled = true

